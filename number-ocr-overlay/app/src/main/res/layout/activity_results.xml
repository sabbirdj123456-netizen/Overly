<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp" android:background="#F7F8FC"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Detected codes" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#111827" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Newest entries appear at the bottom. Repeated consecutive codes are ignored."
        android:textSize="14sp" android:textColor="#5B6472" android:layout_marginTop="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ListView android:id="@+id/resultsList" android:dividerHeight="1dp" android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/copyAllButton" android:text="Copy All"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/exportButton" android:text="Export TXT"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clearButton" android:text="Clear"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
